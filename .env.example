# Google Gemini API Keys
# Get your API keys from: https://aistudio.google.com/app/apikey

# Free tier key (används för text-generering och prompt-förbättring)
GEMINI_API_KEY_FREE=your_free_api_key_here

# Paid tier key (krävs för bildgenerering)
GEMINI_API_KEY_PAID=your_paid_api_key_here

# Whisper Model
# Standard models: tiny, base, small, medium, large-v3
# KBLab Swedish models (REKOMMENDERAT för bästa svensk transkription):
#   - KBLab/kb-whisper-tiny (57.7M - snabbast)
#   - KBLab/kb-whisper-base (99.1M)
#   - KBLab/kb-whisper-small (0.3B - balans)
#   - KBLab/kb-whisper-medium (0.8B - bra kvalitet)
#   - KBLab/kb-whisper-large (2B - bästa kvalitet)
# Rekommenderat: KBLab/kb-whisper-small eller medium för 12GB VRAM
WHISPER_MODEL=KBLab/kb-whisper-small

# Sentence Detection Settings
SILENCE_DURATION=1.5
MIN_SENTENCE_LENGTH=10

# Image Generation Model
# Options:
#   - gemini-2.5-flash-image (Nano Banana - fast, good quality)
#   - imagen-3.0-generate-002 (Imagen 3 - high quality, $0.03/image)
#   - imagen-4.0-generate-001 (Imagen 4 - latest, highest quality)
IMAGE_MODEL=gemini-2.5-flash-image

# Server Settings
WS_HOST=localhost
WS_PORT=8765
HTTP_PORT=8000
