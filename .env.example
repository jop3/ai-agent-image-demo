# Google Gemini API Key
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Whisper Model Size (tiny, base, small, medium, large-v3)
# Recommended: small or medium for 12GB VRAM
WHISPER_MODEL=small

# Sentence Detection Settings
SILENCE_DURATION=1.5
MIN_SENTENCE_LENGTH=10

# Image Generation Model
# Options:
#   - gemini-2.5-flash-image (Nano Banana - fast, good quality)
#   - imagen-3.0-generate-002 (Imagen 3 - high quality, $0.03/image)
#   - imagen-4.0-generate-001 (Imagen 4 - latest, highest quality)
IMAGE_MODEL=gemini-2.5-flash-image

# Server Settings
WS_HOST=localhost
WS_PORT=8765
HTTP_PORT=8000
